// Apploye Production-Grade Schema
// Multi-Tenant SaaS: Time Tracking, Employee Monitoring & Payroll
// Tech: Next.js 14 / Supabase / PostgreSQL / Electron Desktop Client

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum OrgRole {
  ORG_OWNER
  MANAGER
  MEMBER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PricingPlan {
  SOLO
  STANDARD
  ENTERPRISE
}

enum BudgetType {
  TOTAL_COST
  TOTAL_HOURS
  MONTHLY_COST
  MONTHLY_HOURS
  NONE
}

enum TimeEntryType {
  AUTOMATIC_DESKTOP
  MANUAL_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppProductivityCategory {
  PRODUCTIVE
  UNPRODUCTIVE
  NEUTRAL
}

enum LeaveType {
  PAID_TIME_OFF
  SICK_LEAVE
  CASUAL_LEAVE
  UNPAID_LEAVE
}

enum ShiftAttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  HALF_DAY
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  VOID
  OVERDUE
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PROCESSED
  PAID
}

// ----------------------------------------------------
// USER & MULTI-TENANCY
// ----------------------------------------------------

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  fullName        String
  avatarUrl       String?
  platformRole    PlatformRole   @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Multi-tenancy relations
  memberships     OrganizationMember[]
  createdOrgs     Organization[]       @relation("CreatedBy")
  systemAuditLogs AuditLog[]

  @@map("users")
}

model Organization {
  id                      String              @id @default(uuid())
  name                    String
  slug                    String              @unique
  logoUrl                 String?
  ownerId                 String
  owner                   User                @relation("CreatedBy", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Subscription & Stripe Billing
  stripeCustomerId        String?             @unique
  stripeSubscriptionId    String?             @unique
  stripePriceId           String?
  subscriptionStatus      SubscriptionStatus  @default(TRIALING)
  plan                    PricingPlan         @default(STANDARD)
  seatsAllocated          Int                 @default(5)
  trialEndsAt             DateTime?

  // Global Monitoring Policy Settings
  defaultScreenshotFrequency Int             @default(3) // 1-10 per 10-minute block
  stealthModeEnabled         Boolean          @default(false)
  idleTimeoutMinutes         Int              @default(5)
  blurScreenshotsByDefault   Boolean          @default(false)
  allowManualTime            Boolean          @default(true)
  trackAppsAndUrls           Boolean          @default(true)
  timezone                   String           @default("UTC")
  currency                   String           @default("USD")

  // Relations
  members                 OrganizationMember[]
  clients                 Client[]
  projects                Project[]
  shifts                  Shift[]
  leaveRequests           LeaveRequest[]
  invoices                Invoice[]
  payrolls                Payroll[]
  productivityRules       AppClassificationRule[]

  @@map("organizations")
}

model OrganizationMember {
  id                      String         @id @default(uuid())
  organizationId          String
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                    OrgRole        @default(MEMBER)
  jobTitle                String?
  hourlyPayRate           Decimal        @default(0.00) @db.Decimal(10, 2)
  billableHourlyRate      Decimal        @default(0.00) @db.Decimal(10, 2)
  weeklyCapacityHours     Decimal        @default(40.00) @db.Decimal(5, 2)
  isActive                Boolean        @default(true)
  joinedAt                DateTime       @default(now())

  // Per-Member Monitoring Overrides
  overrideScreenshotsPer10m Int?         // Nullable: falls back to Org setting
  stealthModeOverride       Boolean?     // Nullable: falls back to Org setting
  isMonitoringExempt        Boolean      @default(false)

  // Tracking & Operational Data
  timeEntries             TimeEntry[]
  screenshots             Screenshot[]
  activityLogs            ActivityLog[]
  appUrlLogs              AppUrlLog[]
  projectAssignments      ProjectMember[]
  assignedTasks           Task[]
  timesheetApprovals      TimesheetApproval[]
  leaveRequests           LeaveRequest[]
  shiftAttendances        ShiftAttendance[]
  payrolls                Payroll[]

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ----------------------------------------------------
// CLIENTS, PROJECTS & TASKS
// ----------------------------------------------------

model Client {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  companyName     String?
  email           String
  phone           String?
  address         String?
  currency        String        @default("USD")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  projects        Project[]
  invoices        Invoice[]

  @@index([organizationId])
  @@map("clients")
}

model Project {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  color           String        @default("#3B82F6") // Hex color for UI widgets
  isBillable      Boolean       @default(true)
  billingRate     Decimal       @default(0.00) @db.Decimal(10, 2)
  budgetType      BudgetType    @default(NONE)
  budgetAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members         ProjectMember[]
  tasks           Task[]
  timeEntries     TimeEntry[]

  @@index([organizationId, isArchived])
  @@map("projects")
}

model ProjectMember {
  id              String             @id @default(uuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customRate      Decimal?           @db.Decimal(10, 2)

  @@unique([projectId, memberId])
  @@map("project_members")
}

model Task {
  id              String              @id @default(uuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        OrganizationMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  estimatedHours  Decimal?            @db.Decimal(6, 2)
  isCompleted     Boolean             @default(false)
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  timeEntries     TimeEntry[]

  @@index([projectId, isCompleted])
  @@map("tasks")
}

// ----------------------------------------------------
// TIME TRACKING & MONITORING ENGINE (DESKTOP ENGINE)
// ----------------------------------------------------

model TimeEntry {
  id              String             @id @default(uuid())
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  taskId          String?
  task            Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int                @default(0)
  
  entryType       TimeEntryType      @default(AUTOMATIC_DESKTOP)
  isBillable      Boolean            @default(true)
  hourlyRate      Decimal            @default(0.00) @db.Decimal(10, 2)
  
  // Manual Request Fields
  isManual        Boolean            @default(false)
  approvalStatus  ApprovalStatus     @default(APPROVED) // Auto entries are approved; manual starts PENDING
  manualReason    String?
  approvedById    String?
  approvedAt      DateTime?

  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Proof of work associations
  screenshots     Screenshot[]
  activityLogs    ActivityLog[]
  appUrlLogs      AppUrlLog[]
  invoiceItems    InvoiceItem[]

  @@index([memberId, startTime])
  @@index([projectId, startTime])
  @@map("time_entries")
}

model Screenshot {
  id                      String             @id @default(uuid())
  timeEntryId             String?
  timeEntry               TimeEntry?         @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  memberId                String
  member                  OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  storageKey              String             // Supabase Storage path
  publicUrl               String             // CDN / Signed URL
  thumbnailUrl            String?
  
  capturedAt              DateTime           @default(now())
  monitorIndex            Int                @default(0) // Multi-monitor index (0, 1, 2)
  resolution              String?            // e.g. "2560x1440"
  isBlurred               Boolean            @default(false)
  
  // Context snapshot at capture time
  activityScoreAtCapture  Int                @default(0) // 0-100%
  activeAppName           String?
  activeWindowTitle       String?
  isSuspiciousJiggler     Boolean            @default(false)
  isDeletedByAdmin        Boolean            @default(false)

  @@index([memberId, capturedAt])
  @@index([timeEntryId])
  @@map("screenshots")
}

model ActivityLog {
  id                     String             @id @default(uuid())
  timeEntryId            String?
  timeEntry              TimeEntry?         @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  memberId               String
  member                 OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  // 10-Minute block interval bounds
  blockStartTime         DateTime
  blockEndTime           DateTime
  
  // Raw native hooks metrics
  keystrokesCount        Int                @default(0)
  mouseClicksCount       Int                @default(0)
  mouseMovementPixels    Int                @default(0)
  
  activeDurationSeconds  Int                @default(600)
  idleDurationSeconds    Int                @default(0)
  
  // Evaluated productivity
  productivityPercentage Decimal            @default(0.00) @db.Decimal(5, 2) // 0 to 100.00%
  flaggedJigglerPattern  Boolean            @default(false)
  createdAt              DateTime           @default(now())

  @@index([memberId, blockStartTime])
  @@index([timeEntryId])
  @@map("activity_logs")
}

model AppUrlLog {
  id              String                  @id @default(uuid())
  timeEntryId     String?
  timeEntry       TimeEntry?              @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  memberId        String
  member          OrganizationMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  processName     String                  // e.g., "Google Chrome", "Code.exe", "Slack"
  windowTitle     String                  // e.g., "PR #42 - GitHub"
  urlOrDomain     String?                 // e.g., "github.com"
  durationSeconds Int                     @default(0)
  category        AppProductivityCategory @default(NEUTRAL)
  recordedAt      DateTime                @default(now())

  @@index([memberId, recordedAt])
  @@index([timeEntryId])
  @@map("app_url_logs")
}

model AppClassificationRule {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matcherPattern  String                  // Regex or Substring, e.g. "youtube.com", "slack"
  targetField     String                  // "PROCESS" or "DOMAIN"
  category        AppProductivityCategory
  createdAt       DateTime                @default(now())

  @@unique([organizationId, matcherPattern, targetField])
  @@map("app_classification_rules")
}

// ----------------------------------------------------
// TIMESHEET APPROVALS & HR OPERATIONS
// ----------------------------------------------------

model TimesheetApproval {
  id              String             @id @default(uuid())
  organizationId  String
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  periodStartDate DateTime           @db.Date
  periodEndDate   DateTime           @db.Date
  
  totalHoursWorked Decimal           @db.Decimal(7, 2)
  billableHours   Decimal            @db.Decimal(7, 2)
  manualHours     Decimal            @db.Decimal(7, 2)
  
  status          ApprovalStatus     @default(PENDING)
  rejectionReason String?
  
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedByUserId String?

  @@unique([memberId, periodStartDate, periodEndDate])
  @@map("timesheet_approvals")
}

model LeaveRequest {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  leaveType       LeaveType          @default(PAID_TIME_OFF)
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  totalDays       Decimal            @db.Decimal(4, 1)
  reason          String?
  
  status          ApprovalStatus     @default(PENDING)
  reviewerNote    String?
  reviewedByUserId String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([organizationId, memberId, startDate])
  @@map("leave_requests")
}

model Shift {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String             // e.g., "Morning Engineering Shift"
  startTimeUtc    String             // e.g. "09:00"
  endTimeUtc      String             // e.g. "17:00"
  daysOfWeek      Int[]              // [1,2,3,4,5] (Monday to Friday)
  graceMinutes    Int                @default(15)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())

  attendances     ShiftAttendance[]

  @@index([organizationId])
  @@map("shifts")
}

model ShiftAttendance {
  id              String                @id @default(uuid())
  shiftId         String
  shift           Shift                 @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId        String
  member          OrganizationMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date            DateTime              @db.Date
  
  clockInTime     DateTime?
  clockOutTime    DateTime?
  status          ShiftAttendanceStatus @default(ON_TIME)
  lateMinutes     Int                   @default(0)
  notes           String?

  @@unique([shiftId, memberId, date])
  @@map("shift_attendances")
}

// ----------------------------------------------------
// BILLING, CLIENT INVOICING & PAYROLL
// ----------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber      String        // e.g. "INV-2026-001"
  issueDate          DateTime      @db.Date
  dueDate            DateTime      @db.Date
  currency           String        @default("USD")
  
  subtotal           Decimal       @db.Decimal(12, 2)
  taxRatePercent     Decimal       @default(0.00) @db.Decimal(5, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  
  status             InvoiceStatus @default(DRAFT)
  notes              String?
  stripeInvoiceId    String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id              String      @id @default(uuid())
  invoiceId       String
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntryId     String?
  timeEntry       TimeEntry?  @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  description     String
  quantityHours   Decimal     @db.Decimal(8, 2)
  unitPrice       Decimal     @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Payroll {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  periodStartDate DateTime           @db.Date
  periodEndDate   DateTime           @db.Date
  
  totalHours      Decimal            @db.Decimal(8, 2)
  hourlyRate      Decimal            @db.Decimal(10, 2)
  grossPay        Decimal            @db.Decimal(12, 2)
  bonusAmount     Decimal            @default(0.00) @db.Decimal(10, 2)
  deductionAmount Decimal            @default(0.00) @db.Decimal(10, 2)
  netPay          Decimal            @db.Decimal(12, 2)
  
  status          PayrollStatus      @default(DRAFT)
  paymentMethod   String?            // "Stripe Payouts", "Wise", "Bank Wire"
  transactionRef  String?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())

  @@unique([organizationId, memberId, periodStartDate, periodEndDate])
  @@map("payrolls")
}

model AuditLog {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action          String       // e.g. "SCREENSHOT_DELETED", "TIMESHEET_APPROVED"
  entityType      String       // "Screenshot", "TimeEntry", "Organization"
  entityId        String
  metadataJson    Json?
  ipAddress       String?
  createdAt       DateTime     @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
